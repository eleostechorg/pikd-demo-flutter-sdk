platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require 'json'

# Flutter 3.22+ enables Swift Package Manager (SPM) by default. When SPM is on,
# plugins that ship a Package.swift — geolocator_apple, package_info_plus,
# sqflite_darwin — are skipped by flutter_install_all_ios_pods and routed through
# FlutterGeneratedPluginSwiftPackage instead. Those SPM packages are only resolved
# by `flutter run`; a bare `pod install` or a manual Xcode build leaves them
# unresolved, causing:
#   GeneratedPluginRegistrant.m: Module 'geolocator_apple' not found
#
# This block patches .flutter-plugins-dependencies before
# flutter_install_all_ios_pods reads it, forcing all plugins through CocoaPods
# regardless of the user-level `flutter config --enable-swift-package-manager`.
_deps_path = File.expand_path('../.flutter-plugins-dependencies', __FILE__)
if File.exist?(_deps_path)
  _deps = JSON.parse(File.read(_deps_path))
  if _deps.dig('swift_package_manager_enabled', 'ios')
    _deps['swift_package_manager_enabled']['ios'] = false
    File.write(_deps_path, JSON.generate(_deps))
  end
end

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
